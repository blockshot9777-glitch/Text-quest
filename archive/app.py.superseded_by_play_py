# ─────────────────────────── ХОД ИГРЫ ───────────────────────────

def state_facts():
    try:
        S = json.load(open(SAVE, encoding="utf-8"))
    except Exception:
        return None
    return {
        "skills": list(S["pc"].get("skills", {}).keys()),
        "sites": [x["path"] for x in S["world"]["sites_canon"]],
        "status": S.get("status", "alive"),
        "turn": S["meta"]["turn"],
    }


def play_turn(cfg, intent):
    f = state_facts()
    if not f:
        return {"error": "мир не создан"}
    if f["status"] == "dead":
        return {"prose": "Игра окончена.", "dead": True}

    # ── вызов 1: механика, строгий JSON, низкая температура
    raw = call_llm(cfg, SYS_MECH % (", ".join(f["skills"]), "; ".join(f["sites"])),
                   f"Намерение игрока: {intent}", temperature=0.2, max_tokens=400)
    plan = json_from(raw) or {}
    minutes = max(0, min(100000, float(plan.get("minutes", 10) or 10)))
    activity = int(plan.get("activity", 1) or 1)
    checks = (plan.get("checks") or [])[:2]

    args = ["act", "--minutes", str(minutes), "--activity", str(max(0, min(2, activity))), "--window", "30"]
    for c in checks:
        sk = c.get("skill", f["skills"][0] if f["skills"] else "athletics")
        args += ["--check", f"{sk}:{int(c.get('difficulty',20))}:{c.get('label','действие')}:"
                            f"{int(c.get('adv',0))}:{c.get('domain','движение')}"]
    if plan.get("to") in f["sites"]:
        args += ["--to", plan["to"]]

    code, report, err = sim(args)
    if code != 0:
        return {"error": (err or report).strip()[:400], "plan": plan}

    # ── вызов 2: проза, только симптомы, высокая температура
    facts = symptoms_only(report)
    prose = call_llm(cfg, SYS_PROSE,
                     f"Игрок решил: {intent}\n\nЧто это дало:\n{facts}",
                     temperature=0.9, max_tokens=900)
    after = state_facts()
    return {"prose": prose.strip(), "plan": plan, "facts": facts,
            "dead": after and after["status"] == "dead", "turn": after["turn"] if after else 0}


def new_game(cfg, scenario):
    raw = call_llm(cfg, SYS_WORLD, f"Сценарий игрока: {scenario}", temperature=0.8, max_tokens=4000)
    brief = json_from(raw)
    if not brief:
        return {"error": "модель не выдала корректный JSON замысла. Для слабых моделей "
                         "попробуй сценарий проще или модель покрупнее."}
    brief.setdefault("seed", abs(hash(scenario)) % 10**7)
    bpath = os.path.join(HERE, "_brief.json")
    json.dump(brief, open(bpath, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    code, out, err = sim(["new", "--brief", bpath, "--out", SAVE])
    if code != 0:
        return {"error": "замысел не прошёл проверку:\n" + (out or err)[:600], "brief": brief}
    code, report, _ = sim(["look", "--window", "30"])
    prose = call_llm(cfg, SYS_PROSE,
                     "Начало игры. Опиши первую сцену.\n\n" + symptoms_only(report),
                     temperature=0.9, max_tokens=900)
    return {"prose": prose.strip(), "gen": out.strip()}


