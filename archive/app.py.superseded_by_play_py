class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def _send(self, code, body, ctype="application/json"):
        b = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", f"{ctype}; charset=utf-8")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        self._send(200, HTML, "text/html")

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._send(400, json.dumps({"error": "битый запрос"}))
        cfg = req.get("cfg", {})
        try:
            if self.path == "/api/models":
                return self._send(200, json.dumps({"models": list_models(cfg)}, ensure_ascii=False))
            if self.path == "/api/new":
                return self._send(200, json.dumps(new_game(cfg, req.get("scenario", "")), ensure_ascii=False))
            if self.path == "/api/turn":
                return self._send(200, json.dumps(play_turn(cfg, req.get("intent", "")), ensure_ascii=False))
        except urllib.error.URLError as e:
            return self._send(200, json.dumps({"error": f"модель недоступна: {e}"}, ensure_ascii=False))
        except Exception as e:
            return self._send(200, json.dumps({"error": f"{type(e).__name__}: {e}"}, ensure_ascii=False))
        self._send(404, json.dumps({"error": "нет такого пути"}))


