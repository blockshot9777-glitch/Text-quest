#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""ИГРА — окно, выбор модели, свой сценарий.

Архитектура конвейера (в ней весь смысл):

    намерение игрока
        -> вызов 1: модель переводит его в МЕХАНИКУ (строгий JSON, темп. 0.2)
        -> ДВИЖОК считает исход. Модель на него не влияет.
        -> вызов 2: модель пишет ПРОЗУ, получая только симптомы (темп. 0.9)
        -> игрок

Модель никогда не видит сырых чисел и никогда не решает, чем кончилось.
Без этого разделения получается чат-бот с красивой рамкой.

Запуск:  python3 app.py           затем открыть http://localhost:8765
Зависимостей нет — только стандартная библиотека.
"""
import json, os, sys, re, urllib.request, urllib.error, subprocess, threading, webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))
SIM = os.path.join(HERE, "sim.py")
SAVE = os.path.join(HERE, "state.json")
PORT = int(os.environ.get("PORT", 8765))


# ─────────────────────────── ПРОВАЙДЕРЫ МОДЕЛЕЙ ───────────────────────────

def _post(url, payload, headers, timeout=180):
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                 headers={"Content-Type": "application/json", **headers})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def call_llm(cfg, system, user, temperature, max_tokens=1200):
    """Единый вызов для любого провайдера. Возвращает текст."""
    kind = cfg.get("provider", "ollama")
    model = cfg.get("model", "")
    if kind == "ollama":
        base = cfg.get("base_url") or "http://localhost:11434"
        d = _post(f"{base}/api/chat", {
            "model": model, "stream": False,
            "options": {"temperature": temperature, "num_predict": max_tokens},
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": user}]}, {})
        return d.get("message", {}).get("content", "")
    if kind == "openai":
        base = cfg.get("base_url") or "https://api.openai.com/v1"
        d = _post(f"{base}/chat/completions", {
            "model": model, "temperature": temperature, "max_tokens": max_tokens,
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": user}]},
            {"Authorization": f"Bearer {cfg.get('api_key','')}"})
        return d["choices"][0]["message"]["content"]
    if kind == "anthropic":
        base = cfg.get("base_url") or "https://api.anthropic.com/v1"
        d = _post(f"{base}/messages", {
            "model": model, "max_tokens": max_tokens, "temperature": temperature,
            "system": system, "messages": [{"role": "user", "content": user}]},
            {"x-api-key": cfg.get("api_key", ""), "anthropic-version": "2023-06-01"})
        return "".join(b.get("text", "") for b in d.get("content", []))
    if kind == "mock":                      # для проверки конвейера без модели
        return cfg.get("_mock", "")
    raise ValueError(f"неизвестный провайдер: {kind}")


def list_models(cfg):
    """Список доступных моделей — для выпадающего списка в окне."""
    try:
        if cfg.get("provider") == "ollama":
            base = cfg.get("base_url") or "http://localhost:11434"
            with urllib.request.urlopen(f"{base}/api/tags", timeout=5) as r:
                return [m["name"] for m in json.loads(r.read())["models"]]
    except Exception:
        pass
    return []


def json_from(text):
    """Модели любят обрамлять JSON текстом и ```-заборами. Достаём объект."""
    if not text:
        return None
    t = re.sub(r"```(?:json)?|```", "", text).strip()
    try:
        return json.loads(t)
    except Exception:
        pass
    depth, start = 0, None
    for i, ch in enumerate(t):
        if ch == "{":
            if depth == 0: start = i
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0 and start is not None:
                try:
                    return json.loads(t[start:i+1])
                except Exception:
                    start = None
    return None


# ─────────────────────────── ВЫЗОВЫ ДВИЖКА ───────────────────────────

def sim(args, state=SAVE):
    env = dict(os.environ, SIM_STATE=state)
    r = subprocess.run([sys.executable, SIM, *args], capture_output=True, text=True,
                       env=env, cwd=HERE)
    return r.returncode, r.stdout, r.stderr


def symptoms_only(report):
    """Из служебного отчёта берём ТОЛЬКО то, что можно показать модели-рассказчику:
    симптомы, события мира и словесный итог броска. Никаких шкал и целей."""
    out, mode = [], None
    for line in report.splitlines():
        s = line.strip()
        if s.startswith("СИМПТОМЫ"): mode = "sym"; out.append("Состояние тела:"); continue
        if s.startswith("СОБЫТИЯ МИРА"): mode = "ev"; out.append("Что произошло в мире:"); continue
        if s.startswith("ДОСТУПНО"): mode = "av"; out.append("Под рукой прямо сейчас:"); continue
        if s.startswith("БРОСКИ"): mode = "roll"; continue
        if s.startswith("ШКАЛЫ") or s.startswith("===") or s.startswith("---"): mode = None; continue
        if not s or mode is None: continue
        if mode == "roll":
            m = re.search(r"->\s*([А-ЯЁ ()а-яё:,]+)$", s)
            if m: out.append("Исход попытки: " + m.group(1).strip())
            if "ПОСЛЕДСТВИЕ:" in s: out.append("Что ухудшилось: " + s.split("ПОСЛЕДСТВИЕ:")[1].strip())
            continue
        if mode == "av":
            out.append("  " + re.sub(r"\s*\(\d+ с\)", "", s)); continue
        if mode == "sym" and s.startswith("прогноз"): continue
        out.append("  " + s.lstrip("• ").strip())
    # место, время, погода — их игрок ощущает
    for line in report.splitlines():
        if line.startswith("место:"):
            out.insert(0, "Место: " + line.split("место:")[1].split("z=")[0].strip())
        if line.startswith("среда:"):
            env = line.split("·")[0].replace("среда:", "").strip()
            out.insert(1, "Вокруг: " + env)
    return "\n".join(out)


# ─────────────────────────── ПРОМПТЫ ───────────────────────────

SYS_MECH = """Ты — переводчик намерений в механику симулятора. Отвечай ТОЛЬКО JSON, без пояснений.

